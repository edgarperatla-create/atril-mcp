{
  "name": "atril-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets Claude build, edit, animate, review and export Apple Keynote presentations on macOS, with themes, real LaTeX equations and scientific charts",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "start": "node src/index.ts",
    "check": "tsc --noEmit",
    "plantilla": "node tema/importar_plantilla.ts",
    "build": "tsc -p tsconfig.build.json && cp src/grafica_cientifica.py dist/ && chmod +x dist/index.js",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "25.9.9",
    "jszip": "3.10.1",
    "pptxgenjs": "4.0.1",
    "sharp": "0.35.1",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "os": [
    "darwin"
  ],
  "keywords": [
    "academic",
    "claude",
    "keynote",
    "latex",
    "macos",
    "matplotlib",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "powerpoint",
    "presentations",
    "slides"
  ],
  "main": "dist/index.js",
  "bin": {
    "atril-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "temas",
    "tema",
    "LICENSE",
    "README.md",
    "README.es.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edgarperatla-create/atril-mcp.git"
  },
  "homepage": "https://github.com/edgarperatla-create/atril-mcp#readme",
  "bugs": {
    "url": "https://github.com/edgarperatla-create/atril-mcp/issues"
  },
  "author": "Edgar Peralta"
}
